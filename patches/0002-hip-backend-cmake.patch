+    f.seekg(0, std::ios::end);
+    const std::streamoff n = f.tellg();
+    if (n < 0)
+        return false;
+    f.seekg(0, std::ios::beg);
+    out.assign(static_cast<std::size_t>(n), '\0');
+    return n == 0 || static_cast<bool>(f.read(&out[0], n));
