+bool cheshireReadDirectEnabled()
+{
+    static const bool on = [] {
+        const char* e = std::getenv("CHESHIRE_READ_DIRECT");
+        return !(e && std::string(e) == "0");
+    }();
+    return on;
+}
+
+bool cheshireReadDirectCheck()
+{
+    static const bool on = [] {
+        const char* e = std::getenv("CHESHIRE_READ_DIRECT_CHECK");
+        return e && std::string(e) == "1";
+    }();
+    return on;
