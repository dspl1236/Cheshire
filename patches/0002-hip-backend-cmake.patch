+    // fill the current slice with the new similarity score, and keep the column minimum for the next row
+    const TSimAcc pathCostAcc = TSimAcc(pathCost);
+    *sim_xz = pathCostAcc;
+    atomicMin(&sBest[threadIdx.x], pathCostAcc);
+
+    // clamp if TSim = uchar (TSimAcc = unsigned int)
+    pathCost = fminf(255.0f, fmaxf(0.0f, pathCost));
+
+    // aggregate into the final output
+    TSim* volume_xyz = get3DBufferAt(volAgr_d, volAgr_s, volAgr_p, v.x, v.y, v.z);
+    const float val = (float(*volume_xyz) * float(filteringIndex) + pathCost) / float(filteringIndex + 1);
+    *volume_xyz = TSim(val);
+    } // valid
+
+    __syncthreads();
+    if (threadIdx.y == 0 && x < (&volDim.x)[axisT.x])
+        atomicMin(bestSimInY_d + x, sBest[threadIdx.x]);
+}
+#endif // !TSIM_USE_FLOAT
+
 } // namespace depthMap
 } // namespace aliceVision
