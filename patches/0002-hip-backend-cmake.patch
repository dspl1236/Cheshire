+        os << (k ? ", " : "") << names[k] << " " << P.t[k] << " (" << P.n[k] << ")";
+        known += P.t[k];
+    }
+    ALICEVISION_LOG_INFO("cheshire: SfM profile: " << total << " s = " << os.str() << ", other " << total - known);
+}
