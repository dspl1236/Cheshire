+#ifndef TSIM_USE_FLOAT
+/**
+ * @brief cheshire: fused per-row SGM path aggregation.
+ * Same arithmetic as volume_agregateCostVolumeAtXinSlices_kernel, but
+ *  - reads the raw similarity straight from the input volume (no per-row slice copy),
+ *  - keeps the column minimum of the row it writes via atomicMin into bestSimInY_d, so the
+ *    per-row best-Z reduction kernel is not needed (bestSimInY_d must be preset to 0xFF..).
+ * One launch per row instead of three; results are identical (TSimAcc = unsigned int).
+ */
+__global__ void volume_agregateCostVolumeAtXinSlicesFused_kernel(const cudaTextureObject_t rcMipmapImage_tex,
+                                                                 const unsigned int rcSgmLevelWidth,
+                                                                 const unsigned int rcSgmLevelHeight,
+                                                                 const float rcMipmapLevel,
+                                                                 const TSim* volSim_d, const int volSim_s, const int volSim_p,
+                                                                 TSimAcc* xzSliceForY_d, int xzSliceForY_p,
+                                                                 const TSimAcc* xzSliceForYm1_d, const int xzSliceForYm1_p,
+                                                                 const TSimAcc* bestSimInYm1_d,
+                                                                 TSimAcc* bestSimInY_d,
+                                                                 TSim* volAgr_d, const int volAgr_s, const int volAgr_p,
+                                                                 const int3 volDim,
+                                                                 const int3 axisT,
+                                                                 const float step,
+                                                                 const int y,
+                                                                 const float P1,
+                                                                 const float _P2,
+                                                                 const int ySign,
+                                                                 const int filteringIndex,
+                                                                 const ROI roi)
+{
+    const int x = blockIdx.x * blockDim.x + threadIdx.x;
+    const int z = blockIdx.y * blockDim.y + threadIdx.y;
+
+    // per-block column minima (shared-memory atomics are cheap; one global atomic per block
+    // and column afterwards instead of one per depth plane: 243 contended atomics -> ~30)
+    __shared__ TSimAcc sBest[64];
+    if (threadIdx.y == 0)
+        sBest[threadIdx.x] = TSimAcc(~TSimAcc(0));
+    __syncthreads();
+
+    int3 v;
+    (&v.x)[axisT.x] = x;
+    (&v.x)[axisT.y] = y;
+    (&v.x)[axisT.z] = z;
+
+    const bool valid = (x < (&volDim.x)[axisT.x]) && (z < volDim.z);
+    if (valid)
+    {
+    // find texture offset
+    const int beginX = (axisT.x == 0) ? roi.x.begin : roi.y.begin;
+    const int beginY = (axisT.x == 0) ? roi.y.begin : roi.x.begin;
+
+    // raw similarity of this cell (what the slice copy used to provide)
+    const TSimAcc simRaw = TSimAcc(*get3DBufferAt(volSim_d, volSim_s, volSim_p, v));
+    TSimAcc* sim_xz = get2DBufferAt(xzSliceForY_d, xzSliceForY_p, x, z);
