+                                                                 const float _P2,
+                                                                 const int ySign,
+                                                                 const int filteringIndex,
+                                                                 const ROI roi)
+{
+    const int x = blockIdx.x * blockDim.x + threadIdx.x;
+    const int z = blockIdx.y * blockDim.y + threadIdx.y;
+
+    // per-block column minima (shared-memory atomics are cheap; one global atomic per block
+    // and column afterwards instead of one per depth plane: 243 contended atomics -> ~30)
+    __shared__ TSimAcc sBest[64];
+    if (threadIdx.y == 0)
+        sBest[threadIdx.x] = TSimAcc(~TSimAcc(0));
+    __syncthreads();
+
+    int3 v;
+    (&v.x)[axisT.x] = x;
+    (&v.x)[axisT.y] = y;
+    (&v.x)[axisT.z] = z;
+
+    const bool valid = (x < (&volDim.x)[axisT.x]) && (z < volDim.z);
+    if (valid)
+    {
