+    void* dst = cheshire::detail::symbolDevicePtr(symbol);
+    if (!dst) return hipMemcpyToSymbolAsync(symbol, src, count, offset, kind, stream);
+    return hipMemcpyAsync(static_cast<char*>(dst) + offset, src, count, kind, stream);
