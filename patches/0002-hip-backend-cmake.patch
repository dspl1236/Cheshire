+{ return cheshire::mip::memcpy2DToArray(dst, wOff, hOff, src, spitch, width, height, kind); }
+inline hipError_t cudaMemcpy3D(const hipMemcpy3DParms* p) { return cheshire::mip::memcpy3D(p); }
+#else
