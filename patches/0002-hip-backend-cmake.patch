+    if (!f)
+        return false;
+    const std::streamsize size = f.tellg();
+    if (size <= 0)
+        return false;
+    std::vector<uint8_t> bytes(static_cast<std::size_t>(size));
+    f.seekg(0);
+    if (!f.read(reinterpret_cast<char*>(bytes.data()), size))
+        return false;
+    static CheshireGpuJpegPool* pool = new CheshireGpuJpegPool();
+    ::cheshire::jpeg::Codec* codec = pool->acquire();
+    const ::cheshire::jpeg::Status st = codec->decode(bytes.data(), bytes.size(), out);
+    pool->release(codec);
+    return st == ::cheshire::jpeg::Status::Ok && out.width == width && out.height == height && out.channels == 3 &&
